# --- Auth.js ---
# Genera uno con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=
# Google Cloud Console > APIs y servicios > Credenciales > ID de cliente OAuth (Aplicación web)
# URI de redirección autorizado: https://TU-DOMINIO/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# En producción detrás de proxy (Vercel lo detecta solo)
# AUTH_TRUST_HOST=true

# Correos que siempre serán administradores (separados por coma)
ADMIN_EMAILS=tucorreo@gmail.com
# true = los usuarios nuevos quedan pendientes hasta que un admin los apruebe
REQUIRE_APPROVAL=true

# --- Base de datos ---
# Vacío = base local embebida (PGlite) en ./.data. En producción usa Postgres (Supabase, Neon...)
# Supabase en Vercel: botón "Connect" > Transaction pooler (puerto 6543)
DATABASE_URL=
# Opcional: conexión directa/Session pooler (puerto 5432) solo para correr migraciones
MIGRATION_DATABASE_URL=

# --- Cifrado de credenciales de Siigo guardadas en BD ---
# 32 bytes en base64:  openssl rand -base64 32
ENCRYPTION_KEY=

# --- Siigo ---
# true = simula la API de Siigo (para pruebas/demos sin credenciales)
SIIGO_MOCK=false
SIIGO_API_URL=https://api.siigo.com

# Solo desarrollo: habilita un botón "Entrar como dev" sin Google
DEV_LOGIN=false
